# PMO Agent – copy to .env and fill in values

# Required for chat and memory
OPENAI_API_KEY=sk-...

# Optional: Google (paths default to Project-MOE/credentials.json and token.json)
# GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_TOKEN_PATH=token.json
# GOOGLE_CALENDAR_ID=primary

# Philips Hue (Phase 6). Getting started: https://developers.meethue.com/develop/hue-api-v2/getting-started/
# Get app key: python scripts/setup_hue.py (press Link button on bridge)
HUE_BRIDGE_IP=192.168.1.42
HUE_APP_KEY=your-application-key-from-setup-hue
# Set to false only if bridge uses self-signed cert and you get SSL errors (local network only)
# HUE_VERIFY_SSL=true

# Stretch: Pygame face (800x480). Set PMO_FACE=1 to show talking face window.
# PMO_FACE=0

# Pi only: allow reboot via voice/text when user confirms. Set PMO_ALLOW_REBOOT=1 to enable (requires sudo reboot without password for the run user).
# PMO_ALLOW_REBOOT=0

# Pi / no keyboard: mic always on; speak then pause ~1s to submit (Voice Activity Detection). Requires pyaudio + webrtcvad.
# PMO_VOICE_ONLY=0

# Wake word: say the phrase then your question (enables voice-only). Free key at https://console.picovoice.ai/
# PICOVOICE_ACCESS_KEY=
# PMO_WAKE_WORD=0
# Optional: custom .ppn from Picovoice Console (e.g. "Hey pee moe"). Place .ppn in Project-MOE/ or set path:
# PICOVOICE_KEYWORD_PATH=Hey-pee-moe_en_raspberry-pi_v4_0_0.ppn
